# ── LLM (OpenAI-compatible interface) ────────────────────────────────
# LLM_* is canonical. GROQ_API_KEY / GROQ_MODEL / GROQ_BASE_URL are accepted
# as aliases for backwards compatibility with older .env files.
#
# If no key is set at all, the system falls back to MockLLM automatically —
# that is what CI runs on. Set a key here to exercise the real model.
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxx
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
# Leave LLM_PROVIDER unset to auto-select: "groq" when a key is present, else "mock".
# LLM_PROVIDER=groq

# ── Vector database ──────────────────────────────────────────────────
# Relative paths are anchored to the project root, not the process CWD.
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=vehicle_knowledge

# ── Structured filter + sparse index ─────────────────────────────────
VEHICLE_DB_PATH=./data/vehicles.db
BM25_INDEX_PATH=./data/bm25_index.pkl

# ── Embedding model (BGE-M3) ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto  # auto, cpu, cuda

# ── Data source ──────────────────────────────────────────────────────
VEHICLE_DATA_DIR=./DataInUse/VehicleData

# ── Application ──────────────────────────────────────────────────────
APP_ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
