# LLM Configuration (OpenAI-compatible interface)
LLM_API_KEY=sk-xxxxxxxxxx
LLM_MODEL=grok-4.1-mini
LLM_BASE_URL=https://ai.huan666.de/v1
LLM_PROVIDER=groq  # groq, openai, anthropic, etc.

# Vector Database Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=vehicle_knowledge

# Embedding Model Configuration - BGE-M3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto  # auto, cpu, cuda

# Data Configuration
VEHICLE_DATA_DIR=./DataInUse/VehicleData

# Application Settings
APP_ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
